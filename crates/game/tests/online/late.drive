# M7 online: late join (own games). m0 and m1 start; m2 joins the running
# session, replays every stream from entry 0, then its players join.
size 1280x720
# The first launch plays the intro: hold a key to skip it.
wait 150
hold enter 70
idle 400
@host online host private ${ROOMFILE}
@m1 online join code ${ROOMFILE}
@host online wait 90 machines=2
@host online mode own
@!m2 online seats ${LOCALS}
@!m2 online wait 90 online session
@!m2 online settle 30
@host online touch ${STARTED}
@!m2 online bots 4
@m2 online wait-file ${STARTED} 120
@m2 online join invite ${ROOMFILE}
@m2 online wait 60 online session
@m2 online settle 30
@m2 shot 01-caught-up
@m2 online seats ${LOCALS}
online wait 60 views=${PLAYERS}
online bots 4
online settle 60
shot 02-late
@host online end
online wait 90 online room
online expect agreed
quit
